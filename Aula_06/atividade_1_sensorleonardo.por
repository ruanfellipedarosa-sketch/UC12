programa {
  funcao inicio() 
  {
    cadeia sensorleonardo
    real celsius, fahrenheit

    escreva("sensorleonardo: ")
    leia(sensorleonardo)
    escreva("temperatura em celsius: ")
    leia(celsius)
    fahrenheit = (celsius * 9.0 / 5.0 + 32.0)
    escreva(sensorleonardo, ": ", fahrenheit, "F\n")

    
  }
}
