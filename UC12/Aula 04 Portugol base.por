programa {
  funcao inicio() {
    inteiro modo 
    escreva("1-ligar manualmente 2 - desligar manualmente: ")
    leia(modo)
    escolha (modo) {
    caso 1:
    escreva("equipamento Ligado\n")
    pare
    caso 2:
    escreva("equipamento Desligado\n")
    pare
    caso contrario: 
    escreva("opcao invalida\n")
    }
   }
}